{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DarkPrince VPN",
  "version": "1.1.1",
  "identifier": "ru.dprince.vpn",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DarkPrince VPN",
        "width": 430,
        "height": 740,
        "minWidth": 400,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://dprince.online/updates/{{target}}-{{arch}}.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3ODcxMTAzMUE0OENBMDUKUldRRnlrZ2FBeEdIWjYyRkQzb2w5S3pXOGhrMHdyaDRkWE1iRUxMTVJ3MWRqdDBCZzBUYnZKMDEK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "resources": ["core/*"],
    "category": "Utility",
    "shortDescription": "Клиент DarkPrince VPN",
    "longDescription": "Клиент DarkPrince VPN: подписка из кабинета, режим системного прокси и режим полного туннеля.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "polkit", "iproute2"]
      }
    }
  }
}
