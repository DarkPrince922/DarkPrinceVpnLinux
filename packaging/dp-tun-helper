#!/bin/sh
# Помощник DPrince VPN для режима «весь трафик».
#
# Единственное, что требует прав root, — поднять интерфейс dpvpn0 и правила
# маршрутов. Приложение зовёт этот файл через pkexec, а правило polkit
# (ru.dprince.vpn.policy) разрешает это активному пользователю без пароля —
# как у других VPN-клиентов. Поэтому помощник ничего не берёт на веру:
# пользователь — из PKEXEC_UID (его подставляет сам pkexec), адреса серверов
# проверяются по шаблону, команды — только две: up и down.
#
#   dp-tun-helper up 0|1 4:АДРЕС 6:АДРЕС …   — поднять (1 — ещё и IPv6)
#   dp-tun-helper down                      — убрать всё своё
#
# Как это устроено — в engine/src/tun.rs. Правила там же объяснены.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

ADAPTER=dpvpn0
ADDRESS=198.18.0.1/24
ADDRESS6=fd66:6470:7276::1/64
TABLE=7276
PREF_SERVERS=7270
PREF_LOCAL=7271
PREF_TUNNEL=7272

die() {
    echo "dp-tun-helper: $*" >&2
    exit 2
}

# Обязательная команда: не вышла — убираем начатое и выходим с ошибкой.
# Не `set -e`: внутри функции, вызванной из условия, оболочка его не соблюдает.
must() {
    "$@" || {
        echo "dp-tun-helper: не вышло: $*" >&2
        down
        exit 1
    }
}

is_ipv4() {
    printf '%s\n' "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'
}

is_ipv6() {
    case "$1" in
        *:*) printf '%s\n' "$1" | grep -Eq '^[0-9A-Fa-f:]{2,39}$' ;;
        *) return 1 ;;
    esac
}

down() {
    for family in "" "-6"; do
        for pref in $PREF_TUNNEL $PREF_LOCAL $PREF_SERVERS; do
            while ip $family rule del pref "$pref" 2>/dev/null; do :; done
        done
        ip $family route flush table "$TABLE" 2>/dev/null || true
    done
    ip link del "$ADAPTER" 2>/dev/null || true
}

up() {
    ipv6=$1
    shift
    case "$ipv6" in 0|1) ;; *) die "первый аргумент — 0 или 1" ;; esac

    # всё проверяем до первой команды: на полпути не останавливаемся
    v4=""
    v6=""
    for item in "$@"; do
        case "$item" in
            4:*) is_ipv4 "${item#4:}" || die "не адрес IPv4: ${item#4:}"; v4="$v4 ${item#4:}" ;;
            6:*) is_ipv6 "${item#6:}" || die "не адрес IPv6: ${item#6:}"; v6="$v6 ${item#6:}" ;;
            *) die "непонятный аргумент: $item" ;;
        esac
    done
    [ -n "$v4$v6" ] || die "нет ни одного адреса сервера"

    # интерфейс — на того, кто попросил: мосту тогда права не нужны
    [ -n "$PKEXEC_UID" ] || die "запускать через pkexec"
    owner=$(id -nu "$PKEXEC_UID" 2>/dev/null) || die "нет пользователя $PKEXEC_UID"

    # следы прошлого запуска мешали бы добавить правила заново
    down

    must ip tuntap add dev "$ADAPTER" mode tun user "$owner"
    must ip addr add "$ADDRESS" dev "$ADAPTER"
    must ip link set dev "$ADAPTER" up

    # 1. Серверы — по основной таблице, то есть по живому маршруту системы.
    #    Раньше правила туннеля. Чёрная дыра — на случай, когда сети нет:
    #    пакеты ядра к серверу пропадут, а не уйдут по кругу в туннель.
    for ip in $v4; do
        must ip rule add to "$ip/32" lookup main pref "$PREF_SERVERS"
        must ip route replace blackhole "$ip/32" table "$TABLE"
    done
    # 2. Локальная сеть — как была: основная таблица без маршрута по умолчанию.
    must ip rule add lookup main suppress_prefixlength 0 pref "$PREF_LOCAL"
    # 3. Всё остальное — в туннель.
    must ip route replace default dev "$ADAPTER" table "$TABLE"
    must ip rule add lookup "$TABLE" pref "$PREF_TUNNEL"

    # IPv6 тем же порядком, но каждая команда прощает отказ: IPv6 бывает
    # выключен в ядре, и это не повод оставить человека без IPv4.
    if [ "$ipv6" = 1 ]; then
        ip -6 addr add "$ADDRESS6" dev "$ADAPTER" nodad 2>/dev/null || true
        for ip in $v6; do
            ip -6 rule add to "$ip/128" lookup main pref "$PREF_SERVERS" 2>/dev/null || true
            ip -6 route replace blackhole "$ip/128" table "$TABLE" 2>/dev/null || true
        done
        ip -6 rule add lookup main suppress_prefixlength 0 pref "$PREF_LOCAL" 2>/dev/null || true
        ip -6 route replace default dev "$ADAPTER" table "$TABLE" 2>/dev/null || true
        ip -6 rule add lookup "$TABLE" pref "$PREF_TUNNEL" 2>/dev/null || true
    fi
    return 0
}

case "$1" in
    up)
        shift
        up "$@"
        ;;
    down)
        down
        ;;
    *)
        die "команды: up, down"
        ;;
esac
