# Maintainer: DarkPrince VPN
#
# Собирает приложение из исходников и кладёт файлы под учёт pacman.
# Ядро Xray и мост tun2socks скачиваются на этапе prepare(): в репозитории
# их нет, они весят десятки мегабайт и обновляются отдельно от приложения.

pkgname=darkprince-vpn
pkgver=1.0.0
pkgrel=1
pkgdesc="Клиент DarkPrince VPN: подписка из кабинета, системный прокси и полный туннель"
arch=('x86_64' 'aarch64')
url="https://github.com/DarkPrince922/DarkPrinceVpnLinux"
license=('MIT')

# webkit2gtk — окно приложения, appindicator — значок в трее,
# polkit — запрос прав на туннель, iproute2 — сами маршруты
depends=('webkit2gtk-4.1' 'libayatana-appindicator' 'polkit' 'iproute2' 'gtk3')
makedepends=('rust' 'cargo' 'pkgconf' 'curl' 'unzip')
optdepends=('gsettings-desktop-schemas: режим системного прокси в GNOME')

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

_srcdir="DarkPrinceVpnLinux-$pkgver"

prepare() {
    cd "$srcdir/$_srcdir"
    bash scripts/fetch-cores.sh src-tauri/core
}

build() {
    cd "$srcdir/$_srcdir/src-tauri"
    # Собираем только бинарник: .deb и AppImage тут не нужны,
    # раскладкой файлов занимается сам PKGBUILD.
    cargo build --release --locked
}

check() {
    cd "$srcdir/$_srcdir/engine"
    cargo test --release --locked
}

package() {
    cd "$srcdir/$_srcdir"

    install -Dm755 src-tauri/target/release/darkprince-vpn \
        "$pkgdir/usr/bin/darkprince-vpn"

    # ядро и мост живут рядом с приложением: движок ищет их в core/
    install -Dm755 src-tauri/core/xray      "$pkgdir/usr/lib/$pkgname/core/xray"
    install -Dm755 src-tauri/core/tun2socks "$pkgdir/usr/lib/$pkgname/core/tun2socks"
    for dat in geoip.dat geosite.dat; do
        [ -f "src-tauri/core/$dat" ] &&
            install -Dm644 "src-tauri/core/$dat" "$pkgdir/usr/lib/$pkgname/core/$dat"
    done

    install -Dm644 packaging/darkprince-vpn.desktop \
        "$pkgdir/usr/share/applications/$pkgname.desktop"
    install -Dm644 src-tauri/icons/128x128.png \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/$pkgname.png"
    install -Dm644 src-tauri/icons/32x32.png \
        "$pkgdir/usr/share/icons/hicolor/32x32/apps/$pkgname.png"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
